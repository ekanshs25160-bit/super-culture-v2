PORT=5001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=https://super-culture-v2.onrender.com,http://localhost:3000,http://localhost:5173
GEMINI_API_KEY=""

# Allow LAN/Tailscale origins (192.168.x.x, 10.x.x.x, 172.16-31.x.x, 100.64-127.x.x, *.local, *.ts.net).
# Always enabled when NODE_ENV=development; set to true to enable in other environments.
ALLOW_PRIVATE_NETWORK_ORIGINS=false

# Optional security and limit configuration
APP_PASSCODE=""
COOKIE_SECRET=""
STREAM_SECRET=""
MAX_AI_CALLS_PER_DAY=100
DB_PATH="data/super_culture.db"
